{
  "name": "cf-robot-operator",
  "main": "./src/index.js",
  "compatibility_date": "2026-09-25",
  "assets": {
    "directory": "../../src/cf_robot/operator",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cf-robot-operator",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "./migrations"
    }
  ],
  "access": {
    "dev": {
      "aud": "cf-robot-operator-local",
      "identity": {
        "email": "operator@localhost",
        "name": "Local Operator"
      }
    }
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
